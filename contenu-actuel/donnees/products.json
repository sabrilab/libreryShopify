age sensorielle qui vous invite à ralentir, à vous recentrer et à goûter pleinement à l’instant présent.\u003c\/span\u003e\u003c\/p\u003e","published_at":"2026-01-04T13:11:13+01:00","created_at":"2024-12-09T13:56:02+01:00","updated_at":"2026-09-25T20:01:27+02:00","vendor":"Librery","product_type":"","tags":[],"variants":[{"id":55553890255197,"title":"100ML","option1":"100ML","option2":null,"option3":null,"sku":"","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"198.00","grams":0,"compare_at_price":null,"position":3,"product_id":14834682986845,"created_at":"2025-01-01T22:18:09+01:00","updated_at":"2026-09-25T20:01:27+02:00"},{"id":55553890287965,"title":"2ML","option1":"2ML","option2":null,"option3":null,"sku":"","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"7.00","grams":0,"compare_at_price":null,"position":4,"product_id":14834682986845,"created_at":"2025-01-01T22:18:09+01:00","updated_at":"2026-09-25T20:01:27+02:00"}],"images":[{"id":71772457763165,"created_at":"2024-12-09T13:53:22+01:00","position":1,"updated_at":"2024-12-09T13:53:26+01:00","product_id":14834682986845,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0911\/1594\/6333\/files\/MangoWave.png?v=1733748806","width":2000,"height":2000},{"id":71772457795933,"created_at":"2024-12-09T13:53:34+01:00","position":2,"updated_at":"2024-12-09T13:53:38+01:00","product_id":14834682986845,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0911\/1594\/6333\/files\/Mango_visu.png?v=1733748818","width":2000,"height":2000},{"id":71772457828701,"created_at":"2024-12-09T13:55:43+01:00","position":3,"updated_at":"2024-12-09T13:55:46+01:00","product_id":14834682986845,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0911\/1594\/6333\/files\/Mango_package_librery.png?v=1733748946","width":2000,"height":2000}],"options":[{"name":"Format","position":1,"values":["100ML","2ML"]}]},{"id":14834738102621,"title":"Ambert Sunset","handle":"ambert-sunset","body_html":"\u003cp\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003cspan\u003eAmbert Sunset est une fragrance envoûtante et puissante, où la profondeur de l’ambre rencontre la chaleur du bois et l’élégance des fleurs. Les premières notes mêlent l’abricot velouté, le safran épicé et l’osmanthus délicat, offrant une ouverture lumineuse et sensuelle. En son cœur, la rose majestueuse, l’iris palida poudré et le jasmin intemporel tissent une composition florale raffinée. Les notes de fond, dominées par le cuir, l’ambre et le bois de santal, enveloppent ce parfum d’une intensité captivante, laissant un sillage riche et sophistiqué. Ambert Sunset est une ode au crépuscule, un hommage à la beauté du jour qui s’efface lentement dans une chaleur dorée.\u003c\/span\u003e\u003c\/p\u003e","published_at":"2024-12-09T14:11:31+01:00","created_at":"2024-12-09T14:11:31+01:00","updated_at":"2026-09-25T20:01:27+02:00","vendor":"Librery","product_type":"","tags":[],"variants":[{"id":55553864139101,"title":"100ML","option1":"100ML","option2":null,"option3":null,"sku":"","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"198.00","grams":0,"compare_at_price":null,"position":3,"product_id":14834738102621,"created_at":"2025-01-01T22:17:01+01:00","updated_at":"2026-09-25T20:01:27+02:00"},{"id":55553864171869,"title":"2ML","option1":"2ML","option2":null,"option3":null,"sku":"","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"7.00","grams":100,"compare_at_price":null,"position":4,"product_id":14834738102621,"created_at":"2025-01-01T22:17:01+01:00","updated_at":"2026-09-25T20:01:27+02:00"}],"images":[{"id":71772667347293,"created_at":"2024-12-09T14:10:54+01:00","position":1,"updated_at":"2024-12-09T14:10:58+01:00","product_id":14834738102621,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0911\/1594\/6333\/files\/AmbertSunset.png?v=1733749858","width":2000,"height":2000},{"id":71772667380061,"created_at":"2024-12-09T14:10:54+01:00","position":2,"updated_at":"2024-12-09T14:10:59+01:00","product_id":14834738102621,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0911\/1594\/6333\/files\/Ambervisu.png?v=1733749859","width":2000,"height":2000},{"id":71772667478365,"created_at":"2024-12-09T14:11:23+01:00","position":3,"updated_at":"2024-12-09T14:11:27+01:00","product_id":14834738102621,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0911\/1594\/6333\/files\/Ambert_package_librery.png?v=1733749887","width":2000,"height":2000}],"options":[{"name":"Format","position":1,"values":["100ML","2ML"]}]},{"id":14834735415645,"title":"Palmeira","handle":"palmeira","body_html":"\u003cp\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003cspan\u003ePalmeira est un parfum somptueux et apaisant, construit autour de la richesse des fruits rouges et sublimé par une pointe boisée raffinée. Les notes de tête éclatantes de framboise, de fraise, de cassis et de myrtille offrent une ouverture juteuse et lumineuse, évoquant un panier de fruits fraîchement cueillis. En son cœur, un bouquet élégant de violette, de rose, de prune et d’Ambroxan ajoute profondeur et sophistication. Les notes de fond, mêlant praline, bois de santal et musc blanc, enveloppent cette composition d’une chaleur veloutée et réconfortante, tout en laissant un sillage puissant et captivant.\u003c\/span\u003e\u003c\/p\u003e","published_at":"2024-12-09T14:09:55+01:00","created_at":"2024-12-09T14:09:55+01:00","updated_at":"2026-09-25T20:01:27+02:00","vendor":"Librery","product_type":"","tags":["Alchimiste"],"variants":[{"id":55553898512733,"title":"100ML","option1":"100ML","option2":null,"option3":null,"sku":"","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"198.00","grams":0,"compare_at_price":null,"position":3,"product_id":14834735415645,"created_at":"2025-01-01T22:18:34+01:00","updated_at":"2026-09-25T20:01:27+02:00"},{"i