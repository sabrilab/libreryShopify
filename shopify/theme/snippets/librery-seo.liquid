{%- comment -%}
  Titre, description et partage (Open Graph), données structurées des fiches produit.
  La maquette était « noindex » ; la boutique, elle, doit être indexée : aucune balise robots ici.
{%- endcomment -%}
{%- liquid
  assign titre = page_title
  if template.name == 'index'
    assign titre = shop.name | append: ' — Maison de parfum, Paris'
  elsif titre contains shop.name
  else
    assign titre = titre | append: ' — ' | append: shop.name
  endif
  assign desc = page_description | default: settings.description_defaut | strip_html | escape
  assign image = settings.image_partage
  if product and product.featured_media
    assign image = product.featured_media
  elsif collection and collection.image
    assign image = collection.image
  endif
-%}
<title>{{ titre | escape }}{% if current_page != 1 %} — page {{ current_page }}{% endif %}</title>
<meta name="description" content="{{ desc }}">
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ titre | escape }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:type" content="{% if product %}product{% else %}website{% endif %}">
{%- if image %}
<meta property="og:image" content="https:{{ image | image_url: width: 1200 }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
{%- if product %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_media %}"image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
  "description": {{ product.description | strip_html | strip | json }},
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "offers": [
    {%- for v in product.variants -%}
    {
      "@type": "Offer",
      "name": {{ v.title | json }},
      {%- if v.sku != blank %}"sku": {{ v.sku | json }},{% endif %}
      "price": {{ v.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ request.origin | append: v.url | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif %}
